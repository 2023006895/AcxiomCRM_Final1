@model IEnumerable<Customer>
@{ ViewData["Title"] = "Customers"; }
<div class="d-flex justify-content-between mb-3">
  <h3>Customers</h3><a class="btn btn-primary" asp-action="Create">+ New Customer</a>
</div>
<form method="get" class="row g-2 mb-3">
  <div class="col-md-5"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name, email, phone, company" /></div>
  <div class="col-md-3"><select name="status" class="form-select">
      <option value="">All statuses</option>
      @foreach (var s in Customer.Statuses) { <option value="@s" selected="@(ViewBag.Status == s)">@s</option> }
  </select></div>
  <div class="col-md-2"><button class="btn btn-outline-dark w-100">Filter</button></div>
</form>
<table class="table table-striped bg-white align-middle">
  <thead><tr><th>Code</th><th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th>Status</th><th></th></tr></thead>
  <tbody>
  @foreach (var c in Model)
  {
    <tr>
      <td>@c.CustomerCode</td><td>@c.CustomerName</td><td>@c.Email</td><td>@c.Phone</td><td>@c.CompanyName</td>
      <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
      <td class="text-end">
        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@c.CustomerId">View</a>
        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.CustomerId">Edit</a>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
          <form asp-action="Delete" asp-route-id="@c.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Delete this customer?');">
            <button class="btn btn-sm btn-outline-danger">Delete</button></form>
        }
      </td>
    </tr>
  }
  @if (!Model.Any()) { <tr><td colspan="7" class="text-center text-muted">No customers found.</td></tr> }
  </tbody>
</table>
